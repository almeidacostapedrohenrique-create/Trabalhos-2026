class NumerosPrimos{

    constructor(private _numberP? : number, private _numNprimo? : number){
        if(this.veryPrim(this._numberP)){
            this._numNprimo = _numberP;
            this._numberP = undefined;
        } else {
            this._numberP = _numberP;
        }

    }

    get numberP () : number  | undefined {
        return this._numberP
    }

    get numNP () : number | undefined {
        return this._numNprimo
    }

    set numberP (valor: number) {
        if(this.veryPrim(valor)){
            this._numNprimo = valor;
            this._numberP = undefined;
        } else {
           this._numberP = valor;
        }
    }

    set numNP (valor: number) {
        if(this.veryPrim(valor)){
            this._numNprimo = valor;
            this._numberP = undefined;
        } else {
           this._numberP = valor;
        }
    }


    public veryPrim(num?: number){
        if(num != null){
            for(let i = 2; i < num; i++){
                if(num % i == 0){
                    return true
                }
            }
        }
        return false
    }


}

class Fatorar{

    public listaFatorada : number[] = []

    constructor(private numeroFatorado : NumerosPrimos){
        if(this.numeroFatorado.numNP != null){
            this.fatorar(this.numeroFatorado.numNP);
        }
    }

    private fatorar(num : number){
        for(let i = 2; i < num;){
            if(num % i != 0){
                i++;
            }
            else{
                if(this.numeroFatorado.veryPrim(i)){
                    this.listaFatorada.push(i);
                }
                i++;
            }

        }
    }
    
}


let num1 : NumerosPrimos = new NumerosPrimos();

num1.numNP = 100

let f1 = new Fatorar(num1)

console.log(f1.listaFatorada)

